# Server Configuration
PORT=5003

# MongoDB Atlas Connection URI
# e.g. mongodb+srv://<username>:<password>@cluster0.mongodb.net/AItour?retryWrites=true&w=majority
MONGO_URI=mongodb://localhost:27017/AItour

# JWT Secret Key for Authentication
JWT_SECRET=your_jwt_secret_key_change_in_production

# AI Microservice URL (Flask/FastAPI service)
AI_SERVICE_URL=http://127.0.0.1:8000/ai/generate
