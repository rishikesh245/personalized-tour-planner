# ==============================================================================
# Master .gitignore for TourAI Full-Stack Workspace
# ==============================================================================

# 1. CRITICAL: Environment variables, API keys, and Database credentials
.env
.env.*
*.env
!.env.example
!.env.*.example
*.pem
*.key
*.cert
*.crt

# 2. Node.js & Javascript Dependencies (Backend & Frontend)
node_modules/
*/node_modules/
*/*/node_modules/

# Package Manager Logs
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*
.pnpm-debug.log*

# Build Outputs & Bundlers
dist/
dist-ssr/
build/
out/
.vite/
.turbo/
.cache/
.parcel-cache/
frontend/dist/
frontend/dist-ssr/

# 3. Python & AI Microservice (ai-service)
# Bytecode and Cache
__pycache__/
*/__pycache__/
*/*/__pycache__/
*/*/*/__pycache__/
*.py[cod]
*$py.class
.pytest_cache/
.coverage
htmlcov/
.tox/
.nox/
pip-log.txt
pip-delete-this-directory.txt

# Python Virtual Environments
venv/
.venv/
env/
ENV/
env.bak/
venv.bak/
ai-service/venv/
ai-service/.venv/
ai-service/env/
ai-service/ENV/

# 4. Operating System Files
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
desktop.ini

# 5. IDEs and Code Editors
.idea/
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?
*.sublime-project
*.sublime-workspace

# 6. Temporary & Dump Files
*.tmp
*.bak
*.swp
*.patch
